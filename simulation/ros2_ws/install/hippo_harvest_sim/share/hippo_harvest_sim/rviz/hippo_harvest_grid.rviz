Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Fine Grid
      Cell Size: 0.025
      Plane Cell Count: 180
      Color: 180; 180; 180
      Alpha: 0.45
      Line Style:
        Value: Lines
        Line Width: 0.02
      Normal Cell Count: 0
      Offset:
        X: 2.25
        Y: 1.6875
        Z: 0
      Plane: XY
      Reference Frame: map
      Value: true
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Occupancy Map
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /map
      Alpha: 0.9
      Color Scheme: map
      Draw Behind: false
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Robot Marker
      Namespaces:
        robot: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_marker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Waypoint Markers
      Namespaces:
        route_target_labels: true
        route_targets: true
        waypoint_labels: true
        waypoints: true
        workstations: true
        workstation_labels: true
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /waypoint_markers
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        map:
          base_link:
            {}
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Head Diameter: 0.05
      Head Length: 0.05
      Length: 0.03
      Line Style: Lines
      Line Width: 0.03
      Name: Robot Path
      Offset:
        X: 0
        Y: 0
        Z: 0.02
      Pose Color: 255; 255; 255
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.02
      Shaft Length: 0.03
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_path
      Value: true
    - Class: rviz_default_plugins/Path
      Enabled: true
      Head Diameter: 0.05
      Head Length: 0.05
      Length: 0.03
      Line Style: Lines
      Line Width: 0.04
      Name: Nav Plan
      Offset:
        X: 0
        Y: 0
        Z: 0.04
      Pose Color: 255; 140; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.02
      Shaft Length: 0.03
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /nav_plan
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Angle: 0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: TopDown
      Near Clip Distance: 0.01
      Scale: 5.5
      Target Frame: map
      Value: TopDownOrtho (rviz)
      X: 2.25
      Y: 1.6875
Window Geometry:
  Height: 900
  Width: 1400
