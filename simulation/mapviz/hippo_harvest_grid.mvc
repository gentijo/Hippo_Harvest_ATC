capture_directory: "~"
fixed_frame: /map
target_frame: <none>
fix_orientation: false
rotate_90: false
enable_antialiasing: true
show_displays: true
show_status_bar: true
show_capture_tools: true
window_width: 1280
window_height: 800
view_scale: 0.0025
offset_x: 0.20
offset_y: 0.20
use_latest_transforms: true
background: "#e5e7eb"
image_transport: raw
displays:
  - type: mapviz_plugins/grid
    name: grid
    config:
      visible: true
      collapsed: false
      frame: /map
      color: "#9ca3af"
      alpha: 0.20
      draw_order: 0
      width: 0.025
      height: 0.025
      offset_x: 0
      offset_y: 0
  - type: mapviz_plugins/marker
    name: robot marker
    config:
      visible: true
      collapsed: false
      topic: /robot_marker
      draw_order: 100
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
  - type: mapviz_plugins/marker
    name: waypoint markers
    config:
      visible: true
      collapsed: false
      topic: /waypoint_markers
      draw_order: 90
      qos_depth: 10
      qos_history: 1
      qos_reliability: 1
      qos_durability: 2
